{%- comment -%}
	Rejilla de productos de una colección, con agregar directo en cada tarjeta.
	Primero lo que se puede comprar y después el resto (Próximamente), hasta el límite.
{%- endcomment -%}
{%- liquid
	assign collection = section.settings.collection | default: collections.all
	assign link = section.settings.link | default: collection.url
	assign limit = section.settings.limit
	assign shown = 0
-%}
{%- capture cards -%}
	{%- for pass in (1..2) -%}
		{%- for product in collection.products -%}
			{%- if shown >= limit -%}{%- break -%}{%- endif -%}
			{%- liquid
				assign wanted = false
				if pass == 1 and product.available
					assign wanted = true
				elsif pass == 2 and product.available == false
					assign wanted = true
				endif
			-%}
			{%- if wanted -%}
				{%- capture card -%}{% render 'product-card', product: product, id_prefix: section.id, sizes: '(min-width: 900px) 280px, 46vw' %}{%- endcapture -%}
				{%- if card != blank -%}{{ card }}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
			{%- endif -%}
		{%- endfor -%}
	{%- endfor -%}
{%- endcapture -%}
{%- if cards != blank -%}
	<section class="nb-shell nb-feat" aria-labelledby="Feat-{{ section.id }}">
		<div class="nb-head">
			<h2 id="Feat-{{ section.id }}" class="nb-h2">{{ section.settings.heading }}</h2>
			{%- if section.settings.link_label != blank -%}
				<a class="nb-link" href="{{ link }}">{{ section.settings.link_label }}{% render 'icon', name: 'arrow' %}</a>
			{%- endif -%}
		</div>
		<ul class="nb-grid">{{ cards }}</ul>
	</section>
{%- endif -%}

{% schema %}
{
	"name": "Productos",
	"class": "nb-section-feat",
	"settings": [
		{ "type": "text", "id": "heading", "label": "Título", "default": "Nuestros productos" },
		{ "type": "collection", "id": "collection", "label": "Colección", "info": "Vacío: todos los productos." },
		{ "type": "range", "id": "limit", "label": "Máximo de productos", "min": 2, "max": 12, "step": 1, "default": 4 },
		{ "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver toda la tienda" },
		{ "type": "url", "id": "link", "label": "Enlace", "info": "Vacío: la colección elegida." }
	],
	"presets": [{ "name": "Productos" }]
}
{% endschema %}
