{%- comment -%} Búsqueda nativa: productos en rejilla, páginas en lista. {%- endcomment -%}
<div class="nb-shell nb-search">
	<h1 class="nb-page-title">{{ 'search.title' | t }}</h1>
	<form action="{{ routes.search_url }}" method="get" role="search" class="nb-search__form">
		<label class="nb-search__field">
			<span class="nb-sr">{{ 'search.placeholder' | t }}</span>
			{% render 'icon', name: 'search' %}
			<input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
		</label>
		<input type="hidden" name="options[prefix]" value="last">
		<button type="submit" class="nb-btn">{{ 'search.submit' | t }}</button>
	</form>
	{%- if search.performed -%}
		{%- if search.results_count == 0 -%}
			<p class="nb-search__none">{{ 'search.no_results' | t: terms: search.terms | escape }}</p>
		{%- else -%}
			<h2 class="nb-h3 nb-search__title">{{ 'search.results' | t: terms: search.terms | escape }}</h2>
			{%- paginate search.results by 24 -%}
				{%- capture cards -%}
					{%- for item in search.results -%}
						{%- if item.object_type == 'product' -%}
							{% render 'product-card', product: item, id_prefix: section.id, sizes: '(min-width: 900px) 280px, 46vw' %}
						{%- endif -%}
					{%- endfor -%}
				{%- endcapture -%}
				{%- if cards != blank -%}<ul class="nb-grid nb-grid--coll">{{ cards }}</ul>{%- endif -%}
				{%- capture others -%}
					{%- for item in search.results -%}
						{%- unless item.object_type == 'product' -%}<li><a href="{{ item.url }}">{{ item.title }}{% render 'icon', name: 'arrow' %}</a></li>{%- endunless -%}
					{%- endfor -%}
				{%- endcapture -%}
				{%- if others != blank -%}
					<h2 class="nb-h3 nb-search__title">{{ 'search.pages' | t }}</h2>
					<ul class="nb-help__list">{{ others }}</ul>
				{%- endif -%}
				{%- if paginate.pages > 1 -%}<nav class="nb-pages">{{ paginate | default_pagination: previous: '←', next: '→' }}</nav>{%- endif -%}
			{%- endpaginate -%}
		{%- endif -%}
	{%- endif -%}
</div>

{% schema %}
{
	"name": "Búsqueda",
	"class": "nb-section-search"
}
{% endschema %}
