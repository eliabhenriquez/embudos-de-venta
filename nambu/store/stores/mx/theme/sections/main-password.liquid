{%- comment -%} Página de contraseña: marca, mensaje de la tienda y acceso con contraseña. {%- endcomment -%}
<div class="nb-password">
	<div class="nb-password__logo">
		{%- if settings.logo -%}{{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, widths: '200, 400', sizes: '160px' }}{%- else -%}<span class="nb-header__name">{{ shop.name }}</span>{%- endif -%}
	</div>
	<h1 class="nb-page-title">{{ section.settings.heading }}</h1>
	{%- if shop.password_message != blank -%}<p class="nb-password__msg">{{ shop.password_message }}</p>{%- endif -%}
	<details class="nb-password__enter">
		<summary class="nb-link">{{ 'password.enter' | t }}</summary>
		{%- form 'storefront_password', class: 'nb-password__form' -%}
			<label class="nb-sr" for="Password">{{ 'password.password' | t }}</label>
			<input id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
			<button type="submit" class="nb-btn">{{ 'password.submit' | t }}</button>
			{%- if form.errors -%}<div role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
		{%- endform -%}
	</details>
	<p class="nb-password__admin">{{ 'password.admin' | t }} <a href="/admin">{{ 'password.login' | t }}</a></p>
</div>

{% schema %}
{
	"name": "Contraseña",
	"class": "nb-section-password",
	"settings": [
		{ "type": "text", "id": "heading", "label": "Título", "default": "Abrimos pronto" }
	]
}
{% endschema %}
