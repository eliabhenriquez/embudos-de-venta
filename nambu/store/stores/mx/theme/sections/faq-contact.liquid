{%- comment -%}
	Preguntas frecuentes con contacto al lado: las dudas de compra respondidas en la página (bloques «Pregunta») y el
	WhatsApp y el correo de los ajustes del tema. En escritorio, la columna del contacto acompaña al hacer scroll.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
	<section class="nb-shell nb-faq" aria-labelledby="Faq-{{ section.id }}">
		<div class="nb-faq__intro">
			<h2 id="Faq-{{ section.id }}" class="nb-h2">{{ section.settings.heading }}</h2>
			{%- if section.settings.text != blank -%}<p class="nb-faq__lead">{{ section.settings.text }}</p>{%- endif -%}
			<div class="nb-faq__contacts">{% render 'contact-links', class: 'nb-faq__contact', icons: true %}</div>
		</div>
		<div class="nb-faq__list">
			{%- for block in section.blocks -%}
				<details class="nb-qa"{% if forloop.first and section.settings.open_first %} open{% endif %} {{ block.shopify_attributes }}>
					<summary>{{ block.settings.question }}{% render 'icon', name: 'plus' %}</summary>
					<div class="nb-qa__a nb-rte">{{ block.settings.answer }}</div>
				</details>
			{%- endfor -%}
		</div>
	</section>
{%- elsif request.design_mode -%}
	<p class="nb-shell nb-editor-note">Añade preguntas con su respuesta.</p>
{%- endif -%}

{% schema %}
{
	"name": "Preguntas y contacto",
	"class": "nb-section-faq",
	"max_blocks": 10,
	"settings": [
		{ "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
		{ "type": "text", "id": "text", "label": "Texto", "default": "¿Te queda otra duda? Te respondemos por WhatsApp." },
		{ "type": "checkbox", "id": "open_first", "label": "Primera pregunta abierta", "default": true }
	],
	"blocks": [
		{
			"type": "question",
			"name": "Pregunta",
			"settings": [
				{ "type": "text", "id": "question", "label": "Pregunta" },
				{ "type": "richtext", "id": "answer", "label": "Respuesta" }
			]
		}
	],
	"presets": [{ "name": "Preguntas y contacto", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }],
	"enabled_on": { "templates": ["index", "page", "collection"] }
}
{% endschema %}
