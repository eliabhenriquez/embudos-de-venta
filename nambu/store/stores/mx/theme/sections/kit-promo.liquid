{%- comment -%}
	Bloque del kit: la foto del kit sobre un panel verde, sus ventajas con icono (bloques «Ventaja»), el precio con su
	referencia y el botón. Foto: la del ajuste o, si no hay, la principal del kit (se funde con el panel).
{%- endcomment -%}
{%- liquid
	assign kit = section.settings.product
	assign form_id = 'KitPromo-' | append: section.id
	assign media = section.settings.image | default: kit.featured_media.preview_image
	assign heading = section.settings.heading
	if heading == blank
		assign heading = kit.title | split: ':' | first | strip
	endif
-%}
{%- if kit != blank -%}
	{%- capture state -%}{% render 'product-state', product: kit %}{%- endcapture -%}
	<section class="nb-kitpromo" id="kit" aria-labelledby="KitPromoTitle-{{ section.id }}">
		<div class="nb-shell nb-kitpromo__in">
			<figure class="nb-kitpromo__visual">
				{% render 'image', image: media, sizes: '(min-width: 900px) 640px, 100vw', class: 'nb-kitpromo__img', widths: '540, 720, 960, 1280', max_width: 1280 %}
				{%- if section.settings.tag != blank -%}<figcaption class="nb-kitpromo__tag">{{ section.settings.tag }}</figcaption>{%- endif -%}
			</figure>
			<div class="nb-kitpromo__copy">
				<h2 id="KitPromoTitle-{{ section.id }}" class="nb-kitpromo__title">{{ heading }}</h2>
				{%- if section.settings.text != blank -%}<div class="nb-kitpromo__lead">{{ section.settings.text }}</div>{%- endif -%}
				{%- if section.blocks.size > 0 -%}
					<ul class="nb-kitpromo__perks">
						{%- for block in section.blocks -%}
							<li class="nb-kitpromo__perk" {{ block.shopify_attributes }}>
								<span class="nb-kitpromo__icon">{% render 'icon', name: block.settings.icon %}</span>
								<span>{{ block.settings.text }}</span>
							</li>
						{%- endfor -%}
					</ul>
				{%- endif -%}
				<div class="nb-kitpromo__buy">
					<p class="nb-kitpromo__price">
						{% render 'price', product: kit %}
						{% render 'kit-anchor', product: kit, label: section.settings.anchor_label, class: 'nb-kitpromo__anchor' %}
					</p>
					{%- if state == 'available' and kit.has_only_default_variant -%}
						{% render 'product-add', product: kit, form_id: form_id, label: section.settings.button_label %}
					{%- else -%}
						<a class="nb-btn" href="{{ kit.url }}"><span>{{ 'products.view_product' | t }}</span></a>
					{%- endif -%}
				</div>
				{%- if section.settings.note != blank -%}<p class="nb-kitpromo__note">{% render 'icon', name: 'truck' %}<span>{{ section.settings.note }}</span></p>{%- endif -%}
			</div>
		</div>
	</section>
{%- elsif request.design_mode -%}
	<p class="nb-shell nb-editor-note">Elige el kit del bloque.</p>
{%- endif -%}

{% schema %}
{
	"name": "Bloque del kit",
	"class": "nb-section-kitpromo",
	"max_blocks": 4,
	"settings": [
		{ "type": "product", "id": "product", "label": "Kit" },
		{ "type": "image_picker", "id": "image", "label": "Foto", "info": "Vacío: la foto principal del kit. Sobre fondo claro: se funde con el panel verde." },
		{ "type": "text", "id": "tag", "label": "Etiqueta sobre la foto", "default": "Promoción del mes" },
		{ "type": "text", "id": "heading", "label": "Título", "info": "Vacío: el nombre del kit (lo que va antes de «:» en su título)." },
		{ "type": "richtext", "id": "text", "label": "Texto" },
		{ "type": "text", "id": "anchor_label", "label": "Texto del precio de referencia", "info": "Va junto al precio de comparación del kit: «$159.800 solo en los dos sprays». Sin precio de comparación no sale." },
		{ "type": "text", "id": "button_label", "label": "Botón", "default": "Quiero el kit" },
		{ "type": "text", "id": "note", "label": "Línea bajo el botón", "default": "Envío gratis a todo el país." }
	],
	"blocks": [
		{
			"type": "perk",
			"name": "Ventaja",
			"settings": [
				{ "type": "select", "id": "icon", "label": "Icono", "default": "leaf", "options": [
					{ "value": "leaf", "label": "Planta" }, { "value": "drop", "label": "Gota" }, { "value": "box", "label": "Paquete" },
					{ "value": "truck", "label": "Envío" }, { "value": "cash", "label": "Pago" }, { "value": "percent", "label": "Ahorro" },
					{ "value": "shield", "label": "Garantía" }, { "value": "sparkle", "label": "Destello" }
				] },
				{ "type": "text", "id": "text", "label": "Texto" }
			]
		}
	],
	"presets": [{ "name": "Bloque del kit", "blocks": [{ "type": "perk" }, { "type": "perk" }, { "type": "perk" }, { "type": "perk" }] }],
	"enabled_on": { "templates": ["index", "page", "collection"] }
}
{% endschema %}
