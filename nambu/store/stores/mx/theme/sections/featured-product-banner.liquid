{%- comment -%}
	Banner de producto destacado: foto entera a un lado y compra al otro.
	Si no hay producto elegido, en el editor sale un aviso; en la tienda, nada.
{%- endcomment -%}
{%- liquid
	assign product = section.settings.product
	assign media = section.settings.image | default: product.featured_media.preview_image
	assign form_id = 'Banner-' | append: section.id
	assign subtitle = product.metafields.custom.subtitle.value
-%}
{%- if product != blank -%}
	{%- capture state -%}{% render 'product-state', product: product %}{%- endcapture -%}
	<section class="nb-banner" aria-labelledby="BannerTitle-{{ section.id }}">
		<div class="nb-banner__in">
			<figure class="nb-banner__media">
				{% render 'image', image: media, sizes: '(min-width: 900px) 600px, 100vw', class: 'nb-banner__img', widths: '540, 720, 900, 1080, 1440', priority: true %}
			</figure>
			<div class="nb-banner__copy">
				<h2 id="BannerTitle-{{ section.id }}" class="nb-banner__title">{{ section.settings.heading }}</h2>
				{%- if section.settings.text != blank -%}<div class="nb-banner__lead">{{ section.settings.text }}</div>{%- endif -%}
				<div class="nb-banner__product">
					<p><strong>{{ product.title }}</strong>{% if subtitle != blank %}<span>{{ subtitle }}</span>{% endif %}</p>
					{%- if state == 'soon' -%}
						<span class="nb-banner__soon">{{ 'products.coming_soon' | t }}</span>
					{%- else -%}
						{% render 'price', product: product, class: 'nb-banner__price' %}
					{%- endif -%}
				</div>
				<div class="nb-banner__act">
					{%- if state == 'available' and product.has_only_default_variant -%}
						{% render 'product-add', product: product, form_id: form_id %}
					{%- endif -%}
					<a class="nb-btn nb-btn--ghost" href="{{ product.url }}"><span>{{ 'products.view_product' | t }}</span></a>
				</div>
			</div>
		</div>
	</section>
{%- elsif request.design_mode -%}
	<p class="nb-shell nb-editor-note">Elige un producto para el banner.</p>
{%- endif -%}

{% schema %}
{
	"name": "Banner de producto",
	"class": "nb-section-banner",
	"settings": [
		{ "type": "product", "id": "product", "label": "Producto" },
		{ "type": "image_picker", "id": "image", "label": "Imagen", "info": "Vacío: la foto principal del producto. Que no corte el producto." },
		{ "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Producto destacado" },
		{ "type": "richtext", "id": "text", "label": "Texto" }
	],
	"presets": [{ "name": "Banner de producto" }],
	"enabled_on": { "templates": ["index", "page", "collection"] }
}
{% endschema %}
