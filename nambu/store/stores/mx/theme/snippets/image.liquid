{%- comment -%}
	Imagen responsive desde el CDN de Shopify.
	Parámetros: image, sizes, class, widths, priority (hero: eager + fetchpriority), decorative (alt vacío).
{%- endcomment -%}
{%- liquid
	assign img_widths = widths | default: '360, 540, 720, 900, 1080, 1440'
	assign img_alt = image.alt | escape
	if alt != blank
		assign img_alt = alt | escape
	endif
	if decorative
		assign img_alt = ''
	endif
-%}
{%- if image != blank -%}
	{%- if priority -%}
		{{ image | image_url: width: 1440 | image_tag: widths: img_widths, sizes: sizes, class: class, alt: img_alt, loading: 'eager', fetchpriority: 'high' }}
	{%- else -%}
		{{ image | image_url: width: 1440 | image_tag: widths: img_widths, sizes: sizes, class: class, alt: img_alt, loading: 'lazy' }}
	{%- endif -%}
{%- else -%}
	{{ 'product-1' | placeholder_svg_tag: class }}
{%- endif -%}
