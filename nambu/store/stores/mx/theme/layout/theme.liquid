<!doctype html>
<html lang="{{ request.locale.iso_code }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="theme-color" content="#ffffff">
		<link rel="canonical" href="{{ canonical_url }}">
		{%- if settings.favicon -%}
			<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
		{%- endif -%}
		<title>
			{{- page_title -}}
			{%- if current_page != 1 %} – {{ 'general.page' | t: page: current_page }}{% endif -%}
			{%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
		</title>
		{%- if page_description -%}
			<meta name="description" content="{{ page_description | escape }}">
		{%- endif -%}
		{% render 'meta-tags' %}
		{% render 'theme-styles' %}
		{{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}
		<script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
		{% render 'theme-config' %}
		{{ content_for_header }}
	</head>
	<body class="nb-body{% if request.page_type == 'index' %} nb-body--home{% endif %}">
		<a class="nb-skip" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
		{% sections 'header-group' %}
		<main id="MainContent" class="nb-main" role="main" tabindex="-1">
			{{ content_for_layout }}
		</main>
		{% sections 'footer-group' %}
		{%- if settings.cart_type == 'drawer' -%}
			{% section 'cart-drawer' %}
		{%- endif -%}
	</body>
</html>
