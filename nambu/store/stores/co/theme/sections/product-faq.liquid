{%- comment -%}
	Preguntas frecuentes: las del producto (metaobjetos "faq": question, answer en el metacampo
	custom.faqs) y después las generales de la sección (bloques). La respuesta admite texto de
	varias líneas o texto enriquecido.
{%- endcomment -%}
{%- assign entries = product.metafields.custom.faqs.value -%}
{%- if entries.size > 0 or section.blocks.size > 0 -%}
	<section class="nb-shell nb-faq" id="faq" aria-labelledby="Faq-{{ section.id }}">
		<h2 id="Faq-{{ section.id }}" class="nb-h2">{{ section.settings.heading }}</h2>
		<div class="nb-faq__list">
			{%- for entry in entries -%}
				<details class="nb-qa"><summary>{{ entry.question.value }}{% render 'icon', name: 'plus' %}</summary><div class="nb-qa__a nb-rte">
					{%- if entry.answer.type == 'rich_text_field' -%}{{ entry.answer | metafield_tag }}{%- else -%}<p>{{ entry.answer.value | newline_to_br }}</p>{%- endif -%}
				</div></details>
			{%- endfor -%}
			{%- for block in section.blocks -%}
				<details class="nb-qa" {{ block.shopify_attributes }}><summary>{{ block.settings.question }}{% render 'icon', name: 'plus' %}</summary><div class="nb-qa__a nb-rte">{{ block.settings.answer }}</div></details>
			{%- endfor -%}
		</div>
	</section>
{%- endif -%}

{% schema %}
{
	"name": "Preguntas frecuentes",
	"class": "nb-section-faq",
	"settings": [
		{ "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" }
	],
	"blocks": [
		{
			"type": "question",
			"name": "Pregunta",
			"settings": [
				{ "type": "text", "id": "question", "label": "Pregunta", "default": "Pregunta" },
				{ "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Respuesta</p>" }
			]
		}
	],
	"presets": [{ "name": "Preguntas frecuentes" }]
}
{% endschema %}
