{%- comment -%} Producto destacado con foto, datos clave en bloques, precio y compra. {%- endcomment -%}
{%- liquid
	assign product = section.settings.product
	assign media = section.settings.image | default: product.featured_media.preview_image
	assign form_id = 'Spotlight-' | append: section.id
	assign text = section.settings.text
	if text == blank
		assign text = product.metafields.custom.short_description.value | newline_to_br
	endif
-%}
{%- if product != blank -%}
	{%- capture state -%}{% render 'product-state', product: product %}{%- endcapture -%}
	<section class="nb-spot" aria-labelledby="Spot-{{ section.id }}">
		<div class="nb-shell nb-spot__in">
			<figure class="nb-spot__media">{% render 'image', image: media, sizes: '(min-width: 900px) 560px, 100vw', class: 'nb-spot__img' %}</figure>
			<div class="nb-spot__copy">
				<h2 id="Spot-{{ section.id }}" class="nb-h2">{{ section.settings.heading }}</h2>
				{%- if text != blank -%}<div class="nb-spot__lead">{{ text }}</div>{%- endif -%}
				{%- if section.blocks.size > 0 -%}
					<ul class="nb-facts">
						{%- for block in section.blocks -%}
							<li {{ block.shopify_attributes }}>
								<span class="nb-facts__icon">{% render 'icon', name: block.settings.icon %}</span>
								<div><h3>{{ block.settings.title }}</h3>{% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}</div>
							</li>
						{%- endfor -%}
					</ul>
				{%- endif -%}
				<div class="nb-spot__buy">
					{%- if state == 'soon' -%}
						<span class="nb-spot__soon">{{ 'products.coming_soon' | t }}</span>
					{%- else -%}
						{% render 'price', product: product, class: 'nb-spot__price' %}
						{%- if state == 'available' and product.has_only_default_variant -%}
							{% render 'product-add', product: product, form_id: form_id %}
						{%- endif -%}
					{%- endif -%}
				</div>
				<a class="nb-link" href="{{ product.url }}">{{ 'products.view_details' | t }}{% render 'icon', name: 'arrow' %}</a>
			</div>
		</div>
	</section>
{%- elsif request.design_mode -%}
	<p class="nb-shell nb-editor-note">Elige un producto para destacar.</p>
{%- endif -%}

{% schema %}
{
	"name": "Producto destacado",
	"class": "nb-section-spot",
	"max_blocks": 4,
	"settings": [
		{ "type": "product", "id": "product", "label": "Producto" },
		{ "type": "image_picker", "id": "image", "label": "Imagen", "info": "Vacío: la foto principal del producto." },
		{ "type": "text", "id": "heading", "label": "Título", "default": "Conoce el producto" },
		{ "type": "richtext", "id": "text", "label": "Texto", "info": "Vacío: el metacampo custom.short_description del producto." }
	],
	"blocks": [
		{
			"type": "fact",
			"name": "Dato clave",
			"settings": [
				{ "type": "select", "id": "icon", "label": "Icono", "default": "leaf", "options": [
					{ "value": "drop", "label": "Gota" }, { "value": "leaf", "label": "Hoja" }, { "value": "sun", "label": "Sol" },
					{ "value": "sparkle", "label": "Destello" }, { "value": "shield", "label": "Escudo" }, { "value": "box", "label": "Caja" }
				] },
				{ "type": "text", "id": "title", "label": "Título", "default": "Dato clave" },
				{ "type": "text", "id": "text", "label": "Texto" }
			]
		}
	],
	"presets": [{ "name": "Producto destacado" }]
}
{% endschema %}
